<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#246653</item><item name="android:windowBackground">#F3F5F0</item>
        <item name="android:colorControlHighlight">#29246653</item>
        <item name="android:alertDialogTheme">@style/PanelTheme</item>
        <item name="android:statusBarColor">#F3F5F0</item><item name="android:navigationBarColor">#F3F5F0</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="PanelTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#246653</item>
        <item name="android:colorBackground">#FCFDF9</item>
        <item name="android:colorForeground">#1E3027</item>
        <item name="android:textColorPrimary">#1E3027</item>
        <item name="android:textColorSecondary">#5D7064</item>
        <item name="android:textColorAlertDialogListItem">#1E3027</item>
        <item name="android:colorControlHighlight">#20246653</item>
        <item name="android:buttonBarButtonStyle">@style/PanelButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PanelButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PanelButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/PanelButton</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:windowMinWidthMajor">52%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="PanelButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#246653</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">68dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">@drawable/panel_button</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
